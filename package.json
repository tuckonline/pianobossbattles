{
  "name": "pianobossbattles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --config public-app/vite.config.ts",
    "build": "node public-app/build.mjs",
    "start": "node dist/server/public.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "grant-role": "tsx scripts/grant-role.ts",
    "build:next": "next build --webpack",
    "db:generate:sites": "drizzle-kit generate --config hosted/drizzle.config.ts",
    "test:e2e:sites": "playwright test --config playwright.sites.config.ts",
    "build:legacy": "node hosted/build.mjs",
    "dev:api": "tsx public-app/server.ts",
    "pretest": "node public-app/prepare-tests.mjs",
    "test:public-browser": "playwright test --config playwright.public.config.ts",
    "build:preview": "npm run build && node public-app/build-preview.mjs",
    "deploy:preview": "node public-app/deploy-preview.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@electric-sql/pglite": "0.5.8",
    "@supabase/supabase-js": "^2.118.0",
    "@tonejs/midi": "^2.0.28",
    "better-auth": "1.7.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.5.0",
    "next": "^16.4.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "verovio": "^5.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "miniflare": "^4.20260515.0",
    "prettier": "^3.9.8",
    "tar": "^7.5.22",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.0.18",
    "wrangler": "^4.92.0"
  },
  "type": "module"
}

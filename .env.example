# Browser-safe Supabase configuration (Vite exposes only VITE_ variables).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Local development. Set to the approved origin on any future deployment.
APP_ORIGIN=http://localhost:5173
PORT=8788
# Server only: Supabase Connect > Session pooler PostgreSQL connection string.
# Percent-encode special characters in passwords. TLS certificate validation stays enabled.
# Never use VITE_ for this variable. Never commit this value.
DATABASE_URL=
# Server-only CA file downloaded from Supabase Database Settings (never disable TLS verification).
DATABASE_SSL_CA_FILE=

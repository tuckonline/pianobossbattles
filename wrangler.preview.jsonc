      "SUPABASE_URL": "https://huxmltjtovpxxxupuxdg.supabase.co",
      "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_oPdO9q8zNLzqJqWKld5XIQ_3bQNZcpx"
    },
    "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f4dddfd90fcf4d7c9ac1d748fd77eeef" }]
  }
}
